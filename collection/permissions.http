@host = http://localhost:8080

### Assign permissions (create/update) - POST /permissions
POST {{host}}/permissions
Content-Type: application/json

[
  {
    "resourceType": "document",
    "resourceId": "1",
    "relation": "viewer",
    "subjectType": "user",
    "subjectId": "123",
    "subjectRelation": null
  },
  {
    "resourceType": "document",
    "resourceId": "1",
    "relation": "editor",
    "subjectType": "user",
    "subjectId": "456",
    "subjectRelation": null
  }
]

### Assign permission to a subject set (subjectRelation set) - POST /permissions
# Grants document:1#viewer to every member of group:engineering (group:engineering#member)
POST {{host}}/permissions
Content-Type: application/json

[
  {
    "resourceType": "document",
    "resourceId": "1",
    "relation": "viewer",
    "subjectType": "group",
    "subjectId": "engineering",
    "subjectRelation": "member"
  }
]

### Revoke permissions - DELETE /permissions
DELETE {{host}}/permissions
Content-Type: application/json

[
  {
    "resourceType": "document",
    "resourceId": "1",
    "relation": "viewer",
    "subjectType": "user",
    "subjectId": "123",
    "subjectRelation": null
  }
]

### Assign permission - validation error (missing required fields)
POST {{host}}/permissions
Content-Type: application/json

[
  {
    "resourceType": "document",
    "resourceId": "1",
    "relation": "viewer",
    "subjectType": "user",
    "subjectId": "123"
  }
]

### Check permission - POST /permissions/check
POST {{host}}/permissions/check
Content-Type: application/json

{
  "resourceType": "payer",
  "resourceId": "123",
  "permission": "view_payer",
  "subjectType": "user",
  "subjectId": "alice"
}

### Check permission - allowed (expects "authorized": true)
# user:123 is a viewer of document:1 (see the first assign request), so they have view
POST {{host}}/permissions/check
Content-Type: application/json

{
  "resourceType": "document",
  "resourceId": "1",
  "permission": "view",
  "subjectType": "user",
  "subjectId": "123"
}

### Check permission - denied (expects "authorized": false)
# user:789 has no relationship to document:1
POST {{host}}/permissions/check
Content-Type: application/json

{
  "resourceType": "document",
  "resourceId": "1",
  "permission": "view",
  "subjectType": "user",
  "subjectId": "789"
}

### Bulk check permissions - POST /permissions/check/bulk
# Expects document:1 view -> true (user:123 is a viewer), document:2 view -> false (no relationship)
POST {{host}}/permissions/check/bulk
Content-Type: application/json

{
  "subjectType": "user",
  "subjectId": "123",
  "items": [
    {
      "resourceType": "document",
      "resourceId": "1",
      "permission": "view"
    },
    {
      "resourceType": "document",
      "resourceId": "2",
      "permission": "view"
    }
  ]
}

### Bulk check permissions - validation error (empty items)
POST {{host}}/permissions/check/bulk
Content-Type: application/json

{
  "subjectType": "user",
  "subjectId": "123",
  "items": []
}

### Bulk check permissions - validation error (item missing permission)
POST {{host}}/permissions/check/bulk
Content-Type: application/json

{
  "subjectType": "user",
  "subjectId": "123",
  "items": [
    {
      "resourceType": "document",
      "resourceId": "1"
    }
  ]
}
